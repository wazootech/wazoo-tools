{
  "name": "@wazoo/tools",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./sparql": "./src/sparql.ts",
    "./search": "./src/search.ts",
    "./schema": "./src/schema.ts",
    "./import": "./src/import.ts",
    "./export": "./src/export.ts"
  },
  "imports": {
    "ai": "npm:ai@^4.0.0",
    "zod": "npm:zod@^3.22.0"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test -A tests/",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
