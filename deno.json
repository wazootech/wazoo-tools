{
  "name": "@wazoo/tools",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./sparql": "./src/sparql.ts",
    "./search": "./src/search.ts",
    "./schema": "./src/schema.ts",
    "./import": "./src/import.ts",
    "./export": "./src/export.ts"
  },
  "imports": {
    "ai": "npm:ai@^7.0.93",
    "zod": "npm:zod@^4.4.3",
    "@ai-sdk/provider": "npm:@ai-sdk/provider@^4.0.10",
    "@ai-sdk/provider-utils": "npm:@ai-sdk/provider-utils@^5.0.36",
    "@worlds/sdk": "jsr:@worlds/sdk@^0.9.0",
    "@worlds/sdk/search-index": "jsr:@worlds/sdk@^0.9.0/search-index",
    "@worlds/sdk/quad-store": "jsr:@worlds/sdk@^0.9.0/quad-store",
    "@worlds/sdk/sparql-engine": "jsr:@worlds/sdk@^0.9.0/sparql-engine",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --node-modules-dir=none -A tests/",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task test"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
