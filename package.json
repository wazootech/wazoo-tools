{
  "name": "@wazoo/tools",
  "private": true,
  "type": "module",
  "description": "Bun toolchain manifest for @wazoo/tools. The published package is described by jsr.json; scripts/check-manifests.ts keeps the two in sync.",
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": "./src/mod.ts",
    "./sparql": "./src/sparql.ts",
    "./search": "./src/search.ts",
    "./import": "./src/import.ts",
    "./export": "./src/export.ts"
  },
  "scripts": {
    "check": "bun check --no-script",
    "check:manifests": "bun scripts/check-manifests.ts",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run check:manifests && bun run test",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "oxlint --deny-warnings",
    "publish:dry": "jsr publish --dry-run --allow-dirty",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.10",
    "@rdfjs/types": "^2.0.1",
    "@wazoo/sparql-engine": "npm:@jsr/wazoo__sparql-engine@^0.4.1",
    "@worlds/sdk": "npm:@jsr/worlds__sdk@^0.9.0",
    "ai": "^7.0.93",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsr": "0.14.3",
    "oxlint": "1.94.0"
  }
}
